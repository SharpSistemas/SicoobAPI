<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>OpenFinance.Sicoob.Shared</PackageId>
		<LangVersion>12.0</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.4</Version>
		<Authors>RafaelEstevam.Net</Authors>
		<Company>SHARP SISTEMAS LTDA</Company>
		<Product>Base library for Sicoob APIs for C#</Product>
		<Description>Base library for Sicoob APIs for C#</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/lucasmoraes804/SicoobAPI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/lucasmoraes804/SicoobAPI</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>SICOOB</PackageTags>
		<PackageReleaseNotes>
			See examples and documentation on the GitHub page
			https://github.com/lucasmoraes804/SicoobAPI
		</PackageReleaseNotes>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Simple.API" Version="1.8.0" />
	</ItemGroup>

</Project>
